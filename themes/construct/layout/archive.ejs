<section class="page-heading"><div><span class="kicker">02 / NOTES ARCHIVE</span><h1><%= is_category() ? page.category : is_tag() ? page.tag : '研究手记' %></h1><p>研究过程、技术笔记，以及项目的开发记录。</p></div><span class="large-index" aria-hidden="true">02</span></section><div class="archive-layout"><aside class="archive-side"><span class="meta">INDEX / 索引</span><a href="<%= url_for('/archives/') %>">全部手记 <span><%= site.posts.length %></span></a><% site.categories.each(c=>{ %><a href="<%= url_for(c.path) %>" <%- is_category()&&page.category===c.name?'aria-current="page"':'' %>><%= c.name %><span><%= c.length %></span></a><% }); %><a href="<%= url_for('/categories/') %>">分类与标签</a></aside><div><%- partial('_partial/posts') %><div class="pagination"><%- paginator({prev_text:'上一页',next_text:'下一页'}) %></div></div></div>