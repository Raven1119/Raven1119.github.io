<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="<%= page.summary || config.description %>"><title><%= page.title ? page.title+' · ' : '' %><%= config.title %></title><link rel="icon" type="image/svg+xml" href="<%= url_for('/favicon.svg') %>"><link rel="stylesheet" href="<%= url_for('/css/tokens.css') %>"><link rel="stylesheet" href="<%= url_for('/css/primitives.css') %>"><link rel="stylesheet" href="<%= url_for('/css/blog.css') %>"></head>
<body data-cil data-cil-theme="<%= theme.default_theme %>" data-motion-default="<%= theme.motion %>"><a class="skip" href="#main">跳到正文</a>
<header class="masthead"><a class="brand" href="<%= url_for('/') %>" aria-label="Raven 首页"><span class="brand-mark" aria-hidden="true"></span><span>RAVEN<span class="brand-sub">研究手记 / FIELD NOTES</span></span></a><span class="mast-caption">MATERIALS × INTELLIGENCE</span><nav class="desktop-nav" aria-label="主导航"><% theme.navigation.forEach(item => {const active=item.url==='/'?is_home():page.path.startsWith(item.url.slice(1)); %><a href="<%= url_for(item.url) %>" <%- active?'aria-current="page"':'' %>><%= item.label %><small><%= item.en %></small></a><% }); %></nav><button class="menu-button" aria-expanded="false" aria-controls="mobile-nav" type="button">菜单 <span aria-hidden="true">＋</span></button></header>
<nav id="mobile-nav" class="mobile-nav" aria-label="移动主导航" hidden><% theme.navigation.forEach((item,i)=>{ %><a href="<%= url_for(item.url) %>"><span>0<%= i+1 %></span><%= item.label %><small><%= item.en %></small></a><% }); %></nav>
<div class="side-label" aria-hidden="true">RAVEN / INDEPENDENT FIELD NOTES</div><main id="main" tabindex="-1"><%- body %></main>
<footer class="footer"><div class="footer-name">RAVEN<span>研究持续，记录继续。</span></div><div><a href="<%= site.data.profile.github %>" target="_blank" rel="noopener noreferrer">GitHub</a><a href="mailto:<%= site.data.profile.email %>">Email</a><a href="<%= url_for('/categories/') %>">分类</a></div><div class="preferences"><label for="theme-select">配色</label><select id="theme-select"><option value="blue">印刷蓝</option><option value="grey">雨蚀灰</option><option value="night">夜间</option></select><button id="motion-toggle" type="button" aria-pressed="<%= theme.motion %>">动效开关</button></div><p class="footer-bottom">© <%= new Date().getFullYear() %> <%= site.data.profile.name %> · 南京 <span>BUILT WITH HEXO / CONSTRUCT V2</span></p></footer>
<script src="<%= url_for('/js/blog.js') %>" defer></script></body></html>