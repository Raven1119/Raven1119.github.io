<section class="page-heading"><div><span class="kicker">INDEX / 分类与标签</span><h1>从一个方向进入。</h1></div></section><section class="taxonomy"><h2>分类</h2><% if(!site.categories.length){ %><p>暂无分类。</p><% } site.categories.each(c=>{ %><a href="<%= url_for(c.path) %>"><%= c.name %><span><%= c.length %></span></a><% }); %><h2>标签</h2><% site.tags.each(t=>{ %><a href="<%= url_for(t.path) %>"># <%= t.name %><span><%= t.length %></span></a><% }); %></section>